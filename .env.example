# Copy to .env and fill in the secrets. Everything here is also editable at
# runtime from the Settings page, which stores overrides in the database.
#
# Note: build.sh takes its own MMN_REGISTRY from the shell environment, not
# from this file -- see the comment at the top of build.sh.

# --- server ---------------------------------------------------------------
MMN_LOG_LEVEL=INFO
MMN_DATA_DIR=/app/data

# --- auth -----------------------------------------------------------------
# Seeded on first boot only; the account is forced to change its password at
# first login. Changing this later does nothing to an existing admin.
MMN_BOOTSTRAP_ADMIN_USERNAME=admin
MMN_BOOTSTRAP_ADMIN_PASSWORD=password
# Set to true once this sits behind an HTTPS reverse proxy. Leaving it true on
# plain HTTP will break login, because the browser refuses to send the cookie.
MMN_SESSION_COOKIE_SECURE=false
MMN_SESSION_TTL_HOURS=336

# --- diarization (LocalAI, no auth) ---------------------------------------
MMN_DIARIZATION_URL=http://diarization.internal.example:4012/v1/audio/diarization
MMN_DIARIZATION_MODEL=vibevoice-cpp-asr
MMN_DIARIZATION_API_KEY=
MMN_DIARIZATION_TIMEOUT_SEC=1800

# --- llm (OpenAI-compatible) ----------------------------------------------
MMN_LLM_BASE_URL=https://llm.internal.example/v1
MMN_LLM_MODEL=localai/qwen3.6-35b-a3b
MMN_LLM_API_KEY=sk-replace-me
MMN_LLM_SSL_VERIFY=true
MMN_LLM_TIMEOUT_SEC=600

# --- integrations ---------------------------------------------------------
# Calendars and inboxes are per-user and connected from Settings, not here.
#
# Encrypts those stored credentials. Leave blank to generate data/secret.key on
# first boot -- but back that file up, because losing it means every connected
# account has to be reconnected.
MMN_SECRET_KEY=

# Where this app is reachable, used to build OAuth redirect URIs. Google accepts
# https:// or http://localhost only; a LAN address will be rejected by Google.
MMN_PUBLIC_BASE_URL=http://localhost:4020

# Optional: one OAuth client for the whole app, so users can connect Gmail and
# Google Calendar. See "Connecting a calendar and inbox" in README.md -- the
# consent screen must be set to "In production" or refresh tokens die weekly.
MMN_GOOGLE_CLIENT_ID=
MMN_GOOGLE_CLIENT_SECRET=

# --- automatic follow-ups -------------------------------------------------
# Off by default. When on, every thread is re-searched on a timer and anything
# scoring at or above the threshold is attached on its own, marked unread until
# someone opens it. Turn it on from Settings -> Matching rather than here if you
# want to be able to switch it off again without a restart.
MMN_AUTO_MATCH_ENABLED=false
MMN_AUTO_MATCH_INTERVAL_MINUTES=30
# Higher than the 0.6 used to *suggest* a match: attaching unattended deserves
# a higher bar than offering.
MMN_AUTO_MATCH_THRESHOLD=0.8
MMN_AUTO_MATCH_MAX_THREADS_PER_CYCLE=20
MMN_AUTO_MATCH_IDLE_DAYS=30

# --- jobs -----------------------------------------------------------------
MMN_JOB_CONCURRENCY=2
MMN_MAX_UPLOAD_MB=1024
