# Copy to .env and fill in the secrets. Everything here is also editable at
# runtime from the Settings page, which stores overrides in the database.
#
# Note: build.sh takes its own MMN_REGISTRY from the shell environment, not
# from this file -- see the comment at the top of build.sh.

# --- server ---------------------------------------------------------------
MMN_LOG_LEVEL=INFO
MMN_DATA_DIR=/app/data

# --- auth -----------------------------------------------------------------
# Seeded on first boot only; the account is forced to change its password at
# first login. Changing this later does nothing to an existing admin.
MMN_BOOTSTRAP_ADMIN_USERNAME=admin
MMN_BOOTSTRAP_ADMIN_PASSWORD=password
# Set to true once this sits behind an HTTPS reverse proxy. Leaving it true on
# plain HTTP will break login, because the browser refuses to send the cookie.
MMN_SESSION_COOKIE_SECURE=false
MMN_SESSION_TTL_HOURS=336

# --- diarization (LocalAI, no auth) ---------------------------------------
MMN_DIARIZATION_URL=http://diarization.internal.example:4012/v1/audio/diarization
MMN_DIARIZATION_MODEL=vibevoice-cpp-asr
MMN_DIARIZATION_API_KEY=
MMN_DIARIZATION_TIMEOUT_SEC=1800

# --- llm (OpenAI-compatible) ----------------------------------------------
MMN_LLM_BASE_URL=https://llm.internal.example/v1
MMN_LLM_MODEL=localai/qwen3.6-35b-a3b
MMN_LLM_API_KEY=sk-replace-me
MMN_LLM_SSL_VERIFY=true
MMN_LLM_TIMEOUT_SEC=600

# --- mcp ------------------------------------------------------------------
MMN_MCP_CALENDAR_URL=http://calendar-mcp.internal.example:4006
MMN_MCP_CALENDAR_TOKEN=replace-me
MMN_MCP_EMAIL_URL=http://email-mcp.internal.example:4003
MMN_MCP_EMAIL_TOKEN=replace-me
MMN_MCP_PROFILE=stone

# --- jobs -----------------------------------------------------------------
MMN_JOB_CONCURRENCY=2
MMN_MAX_UPLOAD_MB=1024
